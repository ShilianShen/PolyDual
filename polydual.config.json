{
  "out": "output",
  "defaults": {
    "seconds": 5,
    "cutEasing": "smootherstep",
    "hold": 0.8,
    "samples": 60,
    "size": 640,
    "view": [4, -0.9, 2],
    "light": [-3, 5, 6],
    "colors": {
      "mode": "auto",
      "light": { "fill": "#5faf7d", "dualFill": "#d96b6b", "stroke": "#33473d" },
      "dark": { "fill": "#8bd5a0", "dualFill": "#e87979", "stroke": "#d8dee9" }
    },
    "strokeWidth": 1.25,
    "hiddenEdges": {
      "enabled": true,
      "dash": [5, 4],
      "opacity": 0.5,
      "width": 1
    },
    "rotation": {
      "enabled": true,
      "axis": [0.35, 1, -0.25],
      "turns": 1
    }
  },
  "animations": {
    "tetrahedron": { "enabled": true },
    "cube-octahedron": {
      "enabled": true
    },
    "dodecahedron-icosahedron": { "enabled": true }
  }
}
