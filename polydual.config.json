{
  "out": "output",
  "defaults": {
    "seconds": 5,
    "hold": 0.8,
    "samples": 60,
    "size": 640,
    "view": [4, -0.9, 2],
    "light": [-3, 5, 6],
    "colors": {
      "mode": "auto",
      "light": { "fill": "#7db8e0", "dualFill": "#eea771", "stroke": "#243746" },
      "dark": { "fill": "#91cbf2", "dualFill": "#ffc394", "stroke": "#d6e8f5" }
    },
    "strokeWidth": 1.25,
    "rotation": {
      "enabled": true,
      "axis": [0.35, 1, -0.25],
      "turns": 1
    }
  },
  "animations": {
    "tetrahedron": {
      "enabled": true,
      "colors": {
        "light": { "fill": "#59cbb0", "dualFill": "#b19bef" },
        "dark": { "fill": "#7ce8ce", "dualFill": "#c5b2ff" }
      }
    },
    "cube-octahedron": {
      "enabled": true
    },
    "dodecahedron-icosahedron": {
      "enabled": true,
      "colors": {
        "light": { "fill": "#e4b56e", "dualFill": "#dc879e" },
        "dark": { "fill": "#f6cd8d", "dualFill": "#f6a2ba" }
      }
    }
  }
}
